apiVersion: v1
kind: Secret
metadata:
  name: fglab-db-secret
  namespace: fglab
type: Opaque
stringData:
  DATABASE_USER: "INSERT_DATABASE_USER_HERE"
  DATABASE_PASSWORD: "INSERT_DATABASE_PASSWORD_HERE"
  DATABASE_NAME: "INSERT_DATABASE_NAME_HERE"
  DATABASE_HOST: "postgres-service"
  DATABASE_PORT: "5432"
